{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GTKottman/remotion-transitions/schema/transition.schema.json",
  "title": "transition.json",
  "description": "Metadata for one transition. See CONTRIBUTING.md. scripts/validate.mjs enforces the cross-file rules this schema can't.",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "summary",
    "uses",
    "family",
    "subfamily",
    "facets",
    "duration",
    "overlay",
    "requires",
    "params",
    "presets",
    "authors",
    "changelog"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Unique; equals the folder name."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 220
    },
    "uses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "family": {
      "enum": [
        "01-cut",
        "02-blend",
        "03-wipe",
        "04-cover",
        "05-motion",
        "06-distortion",
        "07-morph",
        "08-carry",
        "09-light"
      ]
    },
    "subfamily": {
      "enum": [
        "3d-space",
        "audio-led",
        "blend-mode",
        "blur",
        "break",
        "burn",
        "clock",
        "crossfade",
        "dip-to-colour",
        "flare",
        "flash",
        "geometric",
        "glitch",
        "image-morph",
        "iris",
        "jump-cut",
        "leak",
        "line-led",
        "linear",
        "luma-dissolve",
        "match-cut",
        "object",
        "object-led",
        "organic",
        "panel",
        "pattern",
        "pixel",
        "portal",
        "push-slide",
        "shape",
        "shape-mask",
        "smash-cut",
        "spin",
        "split",
        "stinger",
        "stroke",
        "type",
        "type-led",
        "warp",
        "whip",
        "zoom"
      ]
    },
    "basedOn": {
      "type": "string",
      "description": "Id of the transition this one grew from."
    },
    "facets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "structure",
        "origin",
        "edge",
        "layers",
        "space",
        "timing",
        "tone",
        "function",
        "also"
      ],
      "properties": {
        "structure": {
          "enum": [
            "instant",
            "direct",
            "bridged",
            "continuous"
          ]
        },
        "origin": {
          "enum": [
            "edge-left",
            "edge-right",
            "edge-top",
            "edge-bottom",
            "edge-diagonal",
            "point",
            "edges-inward",
            "path",
            "distributed",
            "whole-frame"
          ]
        },
        "edge": {
          "enum": [
            "none",
            "hard",
            "soft",
            "geometric",
            "organic",
            "textured"
          ]
        },
        "layers": {
          "enum": [
            "A",
            "B",
            "A+B",
            "third"
          ]
        },
        "space": {
          "enum": [
            "2d",
            "2.5d",
            "3d"
          ]
        },
        "timing": {
          "enum": [
            "snap",
            "eased",
            "linear",
            "elastic",
            "beat-synced"
          ]
        },
        "tone": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "clean",
              "playful",
              "bold",
              "luxe",
              "gritty",
              "technical",
              "retro",
              "dreamy"
            ]
          }
        },
        "function": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "continuity",
              "progression",
              "contrast",
              "section-break",
              "reveal",
              "brand",
              "energy"
            ]
          }
        },
        "also": {
          "type": "array",
          "items": {
            "enum": [
              "01-cut/match-cut",
              "01-cut/smash-cut",
              "01-cut/jump-cut",
              "01-cut/audio-led",
              "02-blend/crossfade",
              "02-blend/dip-to-colour",
              "02-blend/luma-dissolve",
              "02-blend/blend-mode",
              "03-wipe/linear",
              "03-wipe/iris",
              "03-wipe/clock",
              "03-wipe/shape-mask",
              "03-wipe/pattern",
              "03-wipe/organic",
              "04-cover/organic",
              "04-cover/geometric",
              "04-cover/stroke",
              "04-cover/panel",
              "04-cover/stinger",
              "05-motion/push-slide",
              "05-motion/whip",
              "05-motion/zoom",
              "05-motion/spin",
              "05-motion/3d-space",
              "05-motion/split",
              "06-distortion/glitch",
              "06-distortion/warp",
              "06-distortion/blur",
              "06-distortion/pixel",
              "06-distortion/break",
              "07-morph/shape",
              "07-morph/type",
              "07-morph/object",
              "07-morph/image-morph",
              "08-carry/object-led",
              "08-carry/line-led",
              "08-carry/type-led",
              "08-carry/portal",
              "09-light/flash",
              "09-light/leak",
              "09-light/burn",
              "09-light/flare"
            ]
          }
        }
      }
    },
    "duration": {
      "type": "object",
      "required": [
        "default",
        "min",
        "max"
      ],
      "additionalProperties": false,
      "properties": {
        "default": {
          "type": "integer",
          "minimum": 1
        },
        "min": {
          "type": "integer",
          "minimum": 1
        },
        "max": {
          "type": "integer",
          "minimum": 1
        }
      },
      "description": "Frames at 30 fps."
    },
    "overlay": {
      "type": "boolean"
    },
    "requires": {
      "type": "array",
      "items": {
        "enum": [
          "webgl2",
          "svg-filters",
          "css-3d"
        ]
      }
    },
    "params": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "type",
          "default",
          "description"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-zA-Z0-9]*$"
          },
          "type": {
            "enum": [
              "number",
              "integer",
              "boolean",
              "string",
              "color",
              "colors",
              "enum"
            ]
          },
          "default": {},
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "presets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "params"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string"
          },
          "params": {
            "type": "object"
          }
        }
      }
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "changelog": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "version",
          "date",
          "notes"
        ],
        "properties": {
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "notes": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
